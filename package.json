{
  "name": "my-blog",
  "version": "19.0.0",
  "private": true,
  "description": "Cloudflare Worker 博客：PWA + 动态内容 + SEO/CSP 加固 + GitHub 云盘 + 全链路测试",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node tests/run-all.mjs",
    "build": "node scripts/build-pages.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "pages:build": "node scripts/build-pages.mjs",
    "build:cloudflare": "node scripts/build-pages.mjs",
    "audit:arch": "node scripts/arch-audit.mjs",
    "test:lazy": "node tests/step29-v17-toolbox.mjs",
    "test:pwa": "node tests/step1-pwa-verify.mjs",
    "test:music": "node tests/step2-music-dynamic.mjs",
    "test:album": "node tests/step2-album-dynamic.mjs",
    "test:seo": "node tests/step3-seo-csp.mjs",
    "test:a11y": "node tests/step4-a11y-audit.mjs",
    "test:lightbox": "node tests/step4-lightbox-trap.mjs",
    "test:ui-stress": "node tests/step3-ui-stress.mjs",
    "test:common": "node tests/step5-common-verify.mjs",
    "test:edge": "node tests/step6-edge-cache.mjs",
    "test:drive": "node tests/step7-drive-api.mjs && node tests/step7-drive-ui.mjs",
    "test:chunked": "node tests/step8-drive-chunked.mjs && node tests/step9-drive-chunked-ui.mjs",
    "test:statemachine": "node tests/step11-drive-state-machine.mjs",
    "test:stress": "node tests/step12-drive-stress.mjs",
    "test:routes": "node tests/step10-routes-verify.mjs",
    "lint": "eslint components utils services modules scripts src",
    "lint:fix": "eslint components utils services modules scripts src --fix",
    "lint:css": "stylelint \"styles/*.css\"",
    "lint:all": "npm run lint && npm run lint:css && npm run audit:arch",
    "build:opt": "node scripts/build-pages.mjs && node scripts/build-optimize.mjs --report .v19-size-report.json",
    "perf:server": "node scripts/perf-server.mjs",
    "critical:inject": "node scripts/inject-critical.mjs",
    "critical:revert": "node scripts/inject-critical.mjs --revert",
    "test:engineering": "node tests/step30-v19-engineering.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "lighthouse": "^12.8.2",
    "playwright": "^1.58.1",
    "stylelint": "^17.16.0"
  },
  "config": {
    "playwright_skip_browser_download": "1"
  }
}
