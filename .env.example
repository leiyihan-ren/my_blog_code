# ============================================================
# .env.example —— 环境变量模板（脱敏，仅含变量名与说明，不含任何真实值）
# 用法：复制为 .env 后填入真实值；.env 已在 .gitignore 中，绝不提交。
# 部署到 Cloudflare Pages 时，请在 Dashboard → Settings → Environment Variables 配置。
# ============================================================

# ---- GitHub 内容同步 ----
# 个人访问令牌（需要 repo 读写权限）：用于文章/相册/云盘写入 GitHub 仓库
GITHUB_TOKEN=

# 目标仓库（格式：owner/repo）与分支；留空则用站点配置里的值
GITHUB_REPO=
GITHUB_BRANCH=main

# ---- 云盘访问口令 ----
# 云盘所有写操作的口令（请求头 x-drive-pin）；留空则云盘禁写
DRIVE_PIN=

# ---- 管理后台 ----
# 管理端口令（admin.html 登录用）
ADMIN_PASSWORD=

# ---- 可选：站点配置覆写 ----
# 站点标题 / 描述等（一般通过 /api/config 在线配置，无需环境变量）
# SITE_TITLE=
# SITE_DESCRIPTION=

# ------------------------------------------------------------
# 安全提醒（红线）：
#   1. 本文件仅为模板，禁止填入真实密钥后提交到仓库
#   2. 真实 .env / .dev.vars 一律不入库、不读取、不外传
#   3. Cloudflare Pages 的 Secret 只在 Dashboard 配置，构建日志不会出现明文
# ------------------------------------------------------------
